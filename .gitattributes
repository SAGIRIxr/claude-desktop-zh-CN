# Normalise to LF in the repo by default.
* text=auto eol=lf

# Windows scripts must keep CRLF on checkout. cmd.exe can mis-parse a .bat with
# bare LF endings (labels and multi-line blocks are the usual casualties), and
# PowerShell here-strings are likewise happier with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Language packs are read by Node with JSON.parse; keep them LF and never let
# git strip the byte order mark handling by treating them as binary.
*.json text eol=lf
